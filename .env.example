# === NTFY PUSH NOTIFICATIONS ===
# Download the ntfy app on your phone and subscribe to a unique topic name
# e.g., if you subscribe to "my_farm_alerts_123", set NTFY_TOPIC=my_farm_alerts_123
NTFY_TOPIC=your_unique_topic_name_here

# === EMAIL CONFIGURATION (GMAIL) ===
# You must generate an "App Password" in your Google Account settings
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password

# === DESTINATION (WHERE TO SEND ALERTS) ===
MY_EMAIL=destination@email.com
